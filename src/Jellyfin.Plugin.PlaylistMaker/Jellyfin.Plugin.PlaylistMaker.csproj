<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.PlaylistMaker</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PlaylistMaker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>false</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" is load-bearing: without it, `dotnet publish` copies Jellyfin's
      own assemblies (Jellyfin.Data.dll, MediaBrowser.Controller.dll, etc.) into this plugin's
      output folder. The server then loads both its own copy AND this bundled copy into the
      same process, and the CLR treats identically-named types (e.g. Jellyfin.Data.Entities.User)
      from the two different assembly instances as unrelated types - causing
      TypeLoadException/MissingMethodException at runtime the moment a type crosses the
      plugin/host boundary, even though the code compiles fine. Compile-time references are
      unaffected; only the runtime copy-to-output is excluded.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.9.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\playlistmaker.html" />
    <EmbeddedResource Include="Web\app.html" />
  </ItemGroup>

</Project>
