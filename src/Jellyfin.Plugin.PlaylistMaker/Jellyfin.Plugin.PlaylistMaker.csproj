<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.PlaylistMaker</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PlaylistMaker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>false</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Must match the actual server version this plugin is deployed against. Jellyfin's plugin
      host does not guarantee binary compatibility across minor versions: compiling against
      10.9.* and loading into a 10.11.x server produced TypeLoadException/MissingMethodException
      on types like Jellyfin.Data.Entities.User the moment they crossed the plugin/host boundary,
      even though the code compiled fine. ExcludeAssets="runtime" keeps `dotnet publish` from
      copying the host's own assemblies into this plugin's output folder (only the host's copies
      should ever be loaded), but it can't paper over an actual ABI mismatch between versions.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\playlistmaker.html" />
    <EmbeddedResource Include="Web\app.html" />
  </ItemGroup>

</Project>
