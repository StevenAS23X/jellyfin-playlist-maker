<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.PlaylistMaker</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PlaylistMaker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>false</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PREP BRANCH for Jellyfin 12.0 (not yet stable/released). Jellyfin 12.0 is the renumbered
      successor to 10.11.x, not a hard plugin-API break (per Jellyfin's own "State of the Fin"
      statement). Confirmed directly against the jellyfin/jellyfin source at tags v12.0-rc4 and
      v12.0-rc6 (identical on both points across those RCs):
        - The host runtime moves from .NET 9 to .NET 10, so TargetFramework must be net10.0.
        - IPlaylistManager.AddItemToPlaylistAsync gained an inserted `int? position` parameter:
          (Guid playlistId, IReadOnlyCollection<Guid> itemIds, int? position, Guid userId).
      Everything else this plugin touches (BasePlugin<T>, IPluginServiceRegistrator,
      IHasWebPages/PluginPageInfo, Jellyfin.Database.Implementations.Entities.User,
      InternalItemsQuery.GenreIds/AlbumIds, IProviderManager.SaveImage, ILibraryManager.GetItemList,
      IUserDataManager.GetUserData, Playlist.OwnerUserId/OpenAccess/Shares, LinkedChild.ItemId,
      BaseItem.HasImage/UpdateToRepositoryAsync) was verified unchanged against the same RC source.
      Do not merge this branch's csproj/package versions into the production branch until 12.0
      actually ships stable - the production branch must keep targeting net9.0/10.11.* until then.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc6" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0-rc6" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\playlistmaker.html" />
    <EmbeddedResource Include="Web\app.html" />
  </ItemGroup>

</Project>
