<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-targeted so the same source tree/DLL-name builds two separate plugin artifacts, one
      per Jellyfin major line - jprm's packaging (see publish-repo.yml / publish-repo-jf12.yml)
      builds each TargetFramework separately via `dotnet build --framework <tfm>`, which works
      fine against a <TargetFrameworks> (plural) project since dotnet just picks that one TFM's
      dependency graph. net9.0 is Jellyfin 10.11.x/11.x's host runtime; net10.0 is Jellyfin 12's
      (confirmed via each version's Jellyfin.Controller nuspec, which only ships a lib group for
      its own runtime - loading a DLL built for the other one is a genuine ABI break, the same
      class of TypeLoadException/MissingMethodException seen when 10.11 moved .NET 8 -> .NET 9).
    -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.PlaylistMaker</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PlaylistMaker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>false</WarningsAsErrors>
  </PropertyGroup>

  <!--
    ExcludeAssets="runtime" on both keeps `dotnet publish` from copying the host's own assemblies
    into this plugin's output folder, so only the host's own copies are ever loaded at runtime.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.*" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\playlistmaker.html" />
    <EmbeddedResource Include="Web\app.html" />
  </ItemGroup>

</Project>
